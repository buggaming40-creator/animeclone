<?xml version="1.0" encoding="utf-8"?>
<!--
  Tab Terbaru (beranda):
    H-1 header logo + nama + tagline + tombol cari/setelan,
    H-2 banner carousel unggulan (auto-scroll + indikator dot),
    H-3 chip filter Semua/Anime/Donghua,
    H-4 seksi Rilis Terbaru + grid poster,
    H-5 seksi Sedang Tayang (horizontal, bila ada data),
    H-6 seksi Top Rating (horizontal, urutan situs, tanpa angka rating),
    H-7 keadaan kosong/muat berikon.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_bg"
    android:orientation="vertical">

    <!-- H-1: header aplikasi -->
    <LinearLayout
        android:id="@+id/uiHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ui_stars"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="16dp"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/ui_bg_avatar" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="@string/guest_name"
                android:src="@drawable/ic_person"
                app:tint="?attr/colorPrimary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/uiGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/greet_night"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/guest_name"
                    android:textColor="@color/text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/uiVerBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="v1.0"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tombol kotak membulat: buka tab Cari -->
        <ImageButton
            android:id="@+id/uiSearchButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/ui_bg_icon_button"
            android:contentDescription="@string/ui_search_desc"
            android:src="@drawable/ic_search"
            app:tint="?attr/colorPrimary" />

        <!-- Tombol kotak membulat: pengumuman -->
        <ImageButton
            android:id="@+id/uiBellButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/ui_bg_icon_button"
            android:contentDescription="@string/announce_title"
            android:src="@drawable/ic_bell"
            app:tint="?attr/colorPrimary" />
    </LinearLayout>

    <!-- Chip jalan pintas genre (ketuk = cari) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingEnd="14dp"
        android:paddingStart="14dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="6dp"
            android:paddingTop="6dp">

            <TextView
                android:id="@+id/uiQuick0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/ui_bg_pill"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="34dp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Action"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/uiQuick1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/ui_bg_pill"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="34dp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Adventure"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/uiQuick2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/ui_bg_pill"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="34dp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Comedy"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/uiQuick3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/ui_bg_pill"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="34dp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Romance"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/uiQuick4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/ui_bg_pill"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="34dp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Fantasy"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Kartu pengumuman (ketuk = dialog info) -->
    <LinearLayout
        android:id="@+id/uiAnnounce"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/ui_bg_dot" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="i"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/announce_title"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/announce_msg"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Ticker sedang tayang (teks berjalan) -->
    <TextView
        android:id="@+id/uiTicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/ui_bg_pill"
        android:ellipsize="marquee"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:marqueeRepeatLimit="marquee_forever"
        android:paddingHorizontal="12dp"
        android:paddingVertical="7dp"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- H-2: banner carousel unggulan -->
    <FrameLayout
        android:id="@+id/uiBannerBox"
        android:layout_width="match_parent"
        android:layout_height="176dp"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/ui_bg_poster"
        android:clipToOutline="true"
        android:visibility="gone">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/uiBanner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/uiDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </FrameLayout>

    <!-- H-3: dihapus — hanya tampilkan Rilis Terbaru agar bersih -->

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="96dp"
                android:paddingEnd="6dp"
                android:paddingStart="6dp"
                android:scrollbars="vertical" />

            <!-- H-7: keadaan kosong -->
            <LinearLayout
                android:id="@+id/emptyBox"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:background="@drawable/ui_bg_icon_button">

                    <ImageView
                        android:id="@+id/emptyIcon"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="center"
                        android:alpha="0.75"
                        android:contentDescription="@string/app_name"
                        app:tint="?attr/colorPrimary" />
                </FrameLayout>

                <TextView
                    android:id="@+id/empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:lineSpacingExtra="5dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
